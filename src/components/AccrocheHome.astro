---
import CoverImage from "./CoverImage.astro";
import { SITE_CONFIG } from "../config";
---
<section class="ge-salon">
  <div class="ge-hero">
    <div class="ge-hero-cadre">
      <CoverImage
        src={SITE_CONFIG.hero.image}
        alt="Commode de notaire, tiroirs ouverts, encre et papiers vélin"
        loading="eager"
        fetchpriority="high"
        width={1200}
        height={800}
      />
    </div>
    <div class="ge-hero-copy">
      <p class="ge-kicker">Sommaire</p>
      <h1>{SITE_CONFIG.hero.title}</h1>
      <p class="ge-chapo">
        Disponible, entreprise, longue. Un livret n’est pas un PER. Un PEL n’est pas de l’argent sous la main.
        Trois tiroirs, et on range avant d’écrire.
      </p>
      <div class="ge-taux">
        <article>
          <p class="ge-chiffre">1,7&nbsp;%</p>
          <p class="ge-libelle">Livret A · août 2026</p>
        </article>
        <article>
          <p class="ge-chiffre">2,5&nbsp;%</p>
          <p class="ge-libelle">LEP · inchangé</p>
        </article>
        <article>
          <p class="ge-chiffre">2,00&nbsp;%</p>
          <p class="ge-libelle">PEL 2026</p>
        </article>
      </div>
    </div>
  </div>
</section>
