---
import CoverImage from "./CoverImage.astro";
import { CATEGORIES } from "../config";

const visuels: Record<string, string> = {
  "epargne-disponible": "/images/tiroir-disponible.jpg",
  "epargne-entreprise": "/images/tiroir-entreprise.jpg",
  "epargne-longue": "/images/tiroir-longue.jpg",
};
---
<section class="ge-salon ge-tiroirs" id="rubriques">
  <div class="ge-ruban">
    <p>Par où commencer</p>
    <p>3 entrées</p>
  </div>
  <div class="ge-tiroirs-grille">
    {CATEGORIES.map((c) => (
      <article class="ge-tiroir">
        {visuels[c.slug] && (
          <CoverImage src={visuels[c.slug]} alt="" width={640} height={400} />
        )}
        {c.question && <p class="ge-tiroir-question">{c.question}</p>}
        <p class="ge-tiroir-nom">{c.label}</p>
        <p class="ge-tiroir-texte">{c.description}</p>
        {c.links && c.links.length > 0 && (
          <ul class="ge-tiroir-liens">
            {c.links.map((lien) => (
              <li>{lien}</li>
            ))}
          </ul>
        )}
        <a class="ge-tiroir-cta" href={`/category/${c.slug}/`}>{c.cta || "Voir les guides"}</a>
      </article>
    ))}
  </div>
</section>
