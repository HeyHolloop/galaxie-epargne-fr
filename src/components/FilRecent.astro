---
const entrees: {
  rubrique: string;
  titre: string;
  date: string;
  href?: string;
}[] = [
  {
    rubrique: "Note de correction",
    titre: "LEP : on avait mal indiqué le plafond de revenu pour un couple — c’est corrigé",
    date: "11 septembre 2026",
  },
  {
    rubrique: "Ajout",
    titre: "Vaut-il mieux emprunter ou piocher dans son épargne pour financer ses travaux ?",
    date: "12 septembre 2026",
    href: "/vaut-il-mieux-emprunter-ou-utiliser-son-epargne/",
  },
];
---
<section class="ge-salon ge-bloc" id="journal">
  <div class="ge-ruban">
    <p>Journal</p>
    <p>Corrections</p>
  </div>
  <div class="ge-journal">
    {entrees.map((e) =>
      e.href ? (
        <a class="ge-journal-item" href={e.href}>
          <p class="ge-teaser-rub">{e.rubrique}</p>
          <p class="ge-teaser-titre">{e.titre}</p>
          <p class="ge-teaser-rub">{e.date}</p>
        </a>
      ) : (
        <div class="ge-journal-item">
          <p class="ge-teaser-rub">{e.rubrique}</p>
          <p class="ge-teaser-titre">{e.titre}</p>
          <p class="ge-teaser-rub">{e.date}</p>
        </div>
      )
    )}
  </div>
</section>
