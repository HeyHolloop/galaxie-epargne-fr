---
import type { CollectionEntry } from "astro:content";
import ArticleTeaser from "./ArticleTeaser.astro";
import { SITE_CONFIG } from "../config";

interface Props {
  items: CollectionEntry<"articles">[];
}
const { items } = Astro.props;
---
<section class="ge-salon ge-bloc">
  <div class="ge-ruban">
    <p>{SITE_CONFIG.ui.mostReadArticles}</p>
    <p>3 fiches</p>
  </div>
  <p class="ge-bloc__soustitre">Les trois fiches que vous ouvrez le plus souvent. Les nouveautés sont juste en dessous.</p>
  <div class="ge-selection ge-selection--simple">
    <div class="ge-liste">
      {items.length === 0 && <p class="ge-vide">{SITE_CONFIG.ui.newContentComing}</p>}
      {items.map((p) => (
        <ArticleTeaser
          href={`/${p.slug}/`}
          title={p.data.title}
          image={p.data.image}
          rubrique={p.data.category}
        />
      ))}
    </div>
  </div>
</section>
