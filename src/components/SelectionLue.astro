---
import type { CollectionEntry } from "astro:content";
import ArticleTeaser from "./ArticleTeaser.astro";
import { SITE_CONFIG } from "../config";
import { formatDate } from "../lib/live";

interface Props {
  items: CollectionEntry<"articles">[];
}
const { items } = Astro.props;
---
<section class="ge-salon ge-bloc">
  <div class="ge-ruban">
    <p>{SITE_CONFIG.ui.mostReadArticles}</p>
    <p>Sélection</p>
  </div>
  <div class="ge-selection">
    <div class="ge-liste">
      {items.length === 0 && <p class="ge-vide">{SITE_CONFIG.ui.newContentComing}</p>}
      {items.map((p) => (
        <ArticleTeaser
          href={`/${p.slug}/`}
          title={p.data.title}
          image={p.data.image}
          rubrique={p.data.category}
          dateLabel={formatDate(p.data.date, SITE_CONFIG.locale)}
        />
      ))}
    </div>
    <aside class="ge-rail">
      <p class="ge-rail-titre">Principe</p>
      <p class="ge-rail-texte">On ne part pas d’un personnage inventé. On part d’un produit, d’un plafond, d’une règle publique.</p>
    </aside>
  </div>
</section>
