---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG, SITE_TITLE, SITE_URL } from "../config";
import { siteOrganization } from "../lib/schema";

const org = {
  ...siteOrganization(SITE_TITLE, SITE_URL),
  "@context": "https://schema.org",
  description: SITE_CONFIG.author.bio,
  email: SITE_CONFIG.contact_email,
};
---
<Layout
  title={`${SITE_CONFIG.ui.masthead} — ${SITE_TITLE}`}
  description={SITE_CONFIG.author.bio}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(org)} />
  <section class="ge-legal">
    <p class="ge-kicker">Méthode Galaxie</p>
    <h1>{SITE_CONFIG.ui.masthead}</h1>
    <p class="ge-sigle" aria-hidden="true">GÉ</p>
    <p>
      On range avant d’écrire. Disponible, entreprise, longue : trois tiroirs, pas un magazine
      argent / retraite / impôt / immo. Un livret, un PEE, un PER n’ont pas la même page, parce
      qu’ils n’ont pas le même délai. Si un sujet n’entre dans aucun tiroir, il n’a pas sa page ici.
    </p>
    <p>
      Les textes partent d’un produit, d’un plafond, d’une règle. Pas d’un portrait, pas d’une
      consigne. Les chiffres viennent d’institutions. Galaxie Épargne est une marque, pas un
      conseiller : on écrit où l’argent est coincé, qui a la main, et ce que dit le texte.
    </p>
  </section>
</Layout>
